generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String?
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  onboardingStep Int      @default(0)
  onboardingDone Boolean  @default(false)
  planType      String    @default("trial")
  planExpiry    DateTime?
  trialEnd      DateTime?

  secretary         Secretary?
  tickets           Ticket[]
  conversations     Conversation[]
  contacts          Contact[]
  notifications     Notification[]
  sessions          Session[]
  activityLogs      ActivityLog[]
  emailStyleExamples EmailStyleExample[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Secretary {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String   @default("Ana")
  avatarId        String   @default("avatar-1")
  tone            String   @default("profesional")
  businessName    String   @default("")
  businessType    String   @default("")
  businessDesc    String   @default("")
  city            String   @default("")
  schedule        String   @default("{}")
  faqs            String   @default("[]")
  rules           String   @default("[]")
  systemPrompt    String   @default("")
  onboardingData  String   @default("{}")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  whatsappNumber    String?
  whatsappToken     String?
  whatsappConnected Boolean @default(false)
  emailConnected    Boolean @default(false)
  emailAddress      String?
  calendarConnected Boolean @default(false)
  calendarId        String?

  appointmentDuration   Int @default(30)
  appointmentBuffer     Int @default(10)
  appointmentMinAdvance Int @default(0)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Ticket {
  id             String   @id @default(cuid())
  userId         String
  contactId      String?
  title          String
  description    String
  priority       String   @default("normal")
  status         String   @default("pending")
  channel        String   @default("whatsapp")
  reason         String   @default("")
  internalNotes  String   @default("")
  resolvedAt     DateTime?
  postponedUntil DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact  Contact?      @relation(fields: [contactId], references: [id])
  messages TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  sender    String
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String   @id @default(cuid())
  userId        String
  contactId     String?
  channel       String   @default("whatsapp")
  status        String   @default("active")
  subject       String?
  lastMessage   String   @default("")
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id])
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  sender         String
  content        String
  channel        String   @default("whatsapp")
  status         String   @default("sent")
  metadata       String?
  isOutOfHours   Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Contact {
  id              String   @id @default(cuid())
  userId          String
  name            String
  phone           String?
  email           String?
  channel         String   @default("whatsapp")
  notes           String   @default("")
  isBlocked       Boolean  @default(false)
  firstContactAt  DateTime @default(now())
  lastInteraction DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  tickets       Ticket[]
  appointments  Appointment[]
}

model Appointment {
  id              String   @id @default(cuid())
  secretaryId     String
  contactId       String?
  title           String
  description     String   @default("")
  startTime       DateTime
  endTime         DateTime
  channel         String   @default("whatsapp")
  status          String   @default("confirmed")
  notes           String   @default("")
  calendarEventId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  secretary Secretary @relation(fields: [secretaryId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String   @default("")
  read      Boolean  @default(false)
  urgent    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailStyleExample {
  id               String   @id @default(cuid())
  userId           String
  category         String   @default("")
  originalDraft    String
  editedVersion    String
  wasEdited        Boolean  @default(false)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  description String
  contactName String   @default("")
  channel     String   @default("whatsapp")
  entityType  String   @default("")
  entityId    String   @default("")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
